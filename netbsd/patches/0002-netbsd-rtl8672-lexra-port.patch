diff --git a/sys/arch/evbmips/rtl8672/rtl8672_clock.c b/sys/arch/evbmips/rtl8672/rtl8672_clock.c
new file mode 100644
index 000000000..319652d0a
--- /dev/null
+++ b/sys/arch/evbmips/rtl8672/rtl8672_clock.c
@@ -0,0 +1,97 @@
+/*	$NetBSD$	*/
+
+/*
+ * Clock and delay support for the RTL8672.
+ *
+ * The Lexra core has no CP0 count/compare registers, so the system clock
+ * comes from on-chip timer 0 (set up in rtl8672_intr.c) and delay() is a
+ * loop that is calibrated against that timer.
+ */
+
+#include <sys/cdefs.h>
+__KERNEL_RCSID(0, "$NetBSD$");
+
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/cpu.h>
+#include <sys/kernel.h>
+
+#include <mips/locore.h>
+
+#include <evbmips/rtl8672/rtl8672reg.h>
+#include <evbmips/rtl8672/rtl8672var.h>
+
+void	rtl8672_clock_enable(void);
+
+/* Iterations of the delay loop per microsecond; a guess until calibrated. */
+static u_int rtl8672_delay_loops = 50;
+
+static inline void
+delay_loop(u_int n)
+{
+
+	while (n-- > 0)
+		__asm volatile("nop");
+}
+
+void
+delay(int n)
+{
+
+	while (n > 1000) {
+		delay_loop(1000 * rtl8672_delay_loops);
+		n -= 1000;
+	}
+	if (n > 0)
+		delay_loop(n * rtl8672_delay_loops);
+}
+
+/*
+ * Count delay loop iterations during one timer period (1/hz seconds).
+ * Runs with the timer already started and its interrupt masked.
+ */
+void
+rtl8672_delay_calibrate(void)
+{
+	const uint32_t ack = RTL8672_TCIR_TC0IE | RTL8672_TCIR_TC0IP;
+	u_int count = 0;
+	int guard;
+
+	/* Synchronise with a timer edge. */
+	RTL8672_REG(RTL8672_TCIR) = ack;
+	for (guard = 0; guard < 20000000; guard++) {
+		if (RTL8672_REG(RTL8672_TCIR) & RTL8672_TCIR_TC0IP)
+			break;
+	}
+	if (guard == 20000000) {
+		printf("rtl8672: timer not running, delay() uncalibrated\n");
+		return;
+	}
+	RTL8672_REG(RTL8672_TCIR) = ack;
+
+	while ((RTL8672_REG(RTL8672_TCIR) & RTL8672_TCIR_TC0IP) == 0) {
+		delay_loop(100);
+		count += 100;
+	}
+	RTL8672_REG(RTL8672_TCIR) = ack;
+
+	/* count iterations per 1/hz seconds */
+	rtl8672_delay_loops = count / (1000000 / hz);
+	if (rtl8672_delay_loops == 0)
+		rtl8672_delay_loops = 1;
+	printf("rtl8672: delay loop %u iterations/us\n", rtl8672_delay_loops);
+}
+
+void
+cpu_initclocks(void)
+{
+
+	rtl8672_clock_enable();
+}
+
+void
+setstatclockrate(int newhz)
+{
+
+	/* nothing: no separate statistics clock */
+}
