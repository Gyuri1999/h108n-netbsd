diff --git a/lib/libc/arch/mips/string/bcmp.S b/lib/libc/arch/mips/string/bcmp.S
index c90fa2c36..9361d093a 100644
--- a/lib/libc/arch/mips/string/bcmp.S
+++ b/lib/libc/arch/mips/string/bcmp.S
@@ -58,12 +58,25 @@ LEAF(bcmp)
 
 	beq		a3, zero, 1f
 	PTR_SUBU	a2, a2, a3	# subtract from remaining count
+#ifdef __LEXRA__
+	/* Lexra cores have no lwl/lwr: compare the 1-3 bytes one at a time. */
+	PTR_ADDU	a3, a3, a0	# end of the unaligned head
+9:
+	lbu		v0, 0(a0)
+	lbu		v1, 0(a1)
+	PTR_ADDU	a0, a0, 1
+	bne		v0, v1, nomatch
+	PTR_ADDU	a1, a1, 1
+	bne		a0, a3, 9b
+	nop
+#else
 	move		v0, v1		# init v0,v1 so unmodified bytes match
 	LWHI		v0, 0(a0)	# read 1, 2, or 3 bytes
 	LWHI		v1, 0(a1)
 	PTR_ADDU	a1, a1, a3
 	bne		v0, v1, nomatch
 	PTR_ADDU	a0, a0, a3
+#endif /* __LEXRA__ */
 1:
 	and		a3, a2, ~3	# compute number of whole words left
 	PTR_SUBU	a2, a2, a3	#   which has to be >= (16-3) & ~3
@@ -91,6 +104,9 @@ unaligned:
 	bne		a0, a3, 1b
 	nop
 2:
+#ifdef __LEXRA__
+	/* No lwl/lwr for the unaligned word loop: finish bytewise below. */
+#else
 	and		a3, a2, ~3	# compute number of whole words left
 	PTR_SUBU	a2, a2, a3	#   which has to be >= (16-3) & ~3
 	PTR_ADDU	a3, a3, a0	# compute ending address
@@ -103,6 +119,7 @@ unaligned:
 	PTR_ADDU	a1, a1, 4
 	bne		a0, a3, 3b
 	nop
+#endif /* __LEXRA__ */
 small:
 	ble		a2, zero, match
 	PTR_ADDU	a3, a2, a0		# compute ending address
diff --git a/lib/libc/arch/mips/string/bzero.S b/lib/libc/arch/mips/string/bzero.S
index f25c02055..4258b0d27 100644
--- a/lib/libc/arch/mips/string/bzero.S
+++ b/lib/libc/arch/mips/string/bzero.S
@@ -56,8 +56,17 @@ LEAF(bzero)
 	beq		a3, zero, 1f	# skip if word aligned
 #if SZREG == 4
 	PTR_SUBU	a1, a1, a3	# subtract from remaining count
+#ifdef __LEXRA__
+	/* Lexra cores have no swl/swr: clear the 1-3 bytes one at a time. */
+	PTR_ADDU	a3, a3, a0	# end of the unaligned head
+9:
+	PTR_ADDU	a0, a0, 1
+	bne		a0, a3, 9b
+	sb		zero, -1(a0)
+#else
 	SWHI		zero, 0(a0)	# clear 1, 2, or 3 bytes to align
 	PTR_ADDU	a0, a0, a3
+#endif /* __LEXRA__ */
 #endif
 #if SZREG == 8
 	PTR_SUBU	a1, a1, a3	# subtract from remaining count
diff --git a/sys/arch/evbmips/conf/RTL8672 b/sys/arch/evbmips/conf/RTL8672
new file mode 100644
index 000000000..8bddf0d29
--- /dev/null
+++ b/sys/arch/evbmips/conf/RTL8672
@@ -0,0 +1,39 @@
+# $NetBSD$
+#
+# RTL8672 -- Realtek RTL8672 based ADSL routers (ZTE ZXHN H108N).
+# First-light configuration: serial console only.
+
+include 	"arch/evbmips/conf/std.rtl8672"
+
+#ident 		"RTL8672-$Revision$"
+
+maxusers	4
+
+options 	MIPS1		# R3000-class core (Lexra RLX5281)
+options 	NOFPU		# No FPU
+options 	FPEMUL		# emulate FPU insn
+
+options 	HZ=100
+options 	MSGBUFSIZE=16384
+
+# Debugging
+options 	DIAGNOSTIC	# extra kernel sanity checking
+options 	DDB		# kernel dynamic debugger
+options 	DDB_HISTORY_SIZE=100
+
+# File systems
+file-system	FFS		# Berkeley Fast Filesystem
+file-system	MFS		# memory-based filesystem
+file-system	KERNFS		# kernel data-structure filesystem
+
+# Networking
+options 	INET		# Internet protocols
+
+config		netbsd		root on ? type ?
+
+mainbus0 	at root
+cpu* 		at mainbus?
+com*		at mainbus?
+
+pseudo-device	loop		# network loopback
+pseudo-device	pty		# pseudo-terminals
diff --git a/sys/arch/evbmips/conf/RTL8672_MD b/sys/arch/evbmips/conf/RTL8672_MD
new file mode 100644
index 000000000..bb6fb01d0
--- /dev/null
+++ b/sys/arch/evbmips/conf/RTL8672_MD
@@ -0,0 +1,17 @@
+# $NetBSD$
+#
+# RTL8672_MD -- RTL8672 kernel with a root file system in a memory disk.
+# The image built in distrib/evbmips/rtl8672ramdisk is inserted with
+# mdsetimage; MEMORY_DISK_ROOT_SIZE (in 512-byte blocks) must cover it.
+
+include 	"arch/evbmips/conf/RTL8672"
+
+pseudo-device	md				# memory disk device
+options 	MEMORY_DISK_HOOKS
+options 	MEMORY_DISK_IS_ROOT		# force root on memory disk
+options 	MEMORY_DISK_SERVER=0		# no userspace memory disk
+options 	MEMORY_DISK_ROOT_SIZE=6144	# 3 MB
+
+# Print pc, address, cause and registers for every user-mode fault that
+# becomes a signal (sigdebug() in mips/trap.c).  Bring-up aid.
+makeoptions 	CPPFLAGS+="-DTRAP_SIGDEBUG"
