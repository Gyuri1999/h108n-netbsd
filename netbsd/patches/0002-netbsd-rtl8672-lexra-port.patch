+options		EXEC_SCRIPT	# exec #! scripts
+
+makeoptions	DEFTEXTADDR="0x80010000"
+makeoptions	BOARDTYPE="rtl8672"
+
+# -mlexra is a local GCC option: never emit lwl/lwr/swl/swr.
+# __LEXRA__ selects the matching paths in hand-written assembly.
