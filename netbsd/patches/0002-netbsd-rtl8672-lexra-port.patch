diff --git a/sys/arch/evbmips/rtl8672/com_mainbus.c b/sys/arch/evbmips/rtl8672/com_mainbus.c
new file mode 100644
index 000000000..ac81b6d56
--- /dev/null
+++ b/sys/arch/evbmips/rtl8672/com_mainbus.c
@@ -0,0 +1,71 @@
+/*	$NetBSD$	*/
+
+#include <sys/cdefs.h>
+__KERNEL_RCSID(0, "$NetBSD$");
+
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/device.h>
+#include <sys/kernel.h>
+#include <sys/tty.h>
+#include <sys/bus.h>
+#include <sys/intr.h>
+
+#include <dev/ic/comreg.h>
+#include <dev/ic/comvar.h>
+
+#include <evbmips/rtl8672/autoconf.h>
+#include <evbmips/rtl8672/rtl8672reg.h>
+#include <evbmips/rtl8672/rtl8672var.h>
+
+struct com_mainbus_softc {
+	struct	com_softc sc_com;	/* real "com" softc */
+	void	*sc_ih;			/* interrupt handler */
+};
+
+static int	com_mainbus_match(device_t, cfdata_t, void *);
+static void	com_mainbus_attach(device_t, device_t, void *);
+
+CFATTACH_DECL_NEW(com_mainbus, sizeof(struct com_mainbus_softc),
+    com_mainbus_match, com_mainbus_attach, NULL, NULL);
+
+static int
+com_mainbus_match(device_t parent, cfdata_t match, void *aux)
+{
+	struct mainbus_attach_args *ma = aux;
+
+	if (strcmp(ma->ma_name, match->cf_name) == 0)
+		return (1);
+
+	return (0);
+}
+
+static void
+com_mainbus_attach(device_t parent, device_t self, void *aux)
+{
+	struct com_mainbus_softc *msc = device_private(self);
+	struct com_softc *sc = &msc->sc_com;
+	struct mainbus_attach_args *ma = aux;
+	bus_space_handle_t ioh;
+
+	sc->sc_dev = self;
+	if (com_is_console(ma->ma_iot, ma->ma_addr, &ioh) == 0 &&
+	    bus_space_map(ma->ma_iot, ma->ma_addr,
+	    COM_NPORTS << RTL8672_UART_REGSHIFT, 0, &ioh) != 0) {
+		aprint_error(": can't map i/o space\n");
+		return;
+	}
+	com_init_regs_stride(&sc->sc_regs, ma->ma_iot, ioh, ma->ma_addr,
+	    RTL8672_UART_REGSHIFT);
+
+	sc->sc_frequency = rtl8672_configuration.rc_uart_freq;
+	sc->sc_type = COM_TYPE_NORMAL;
+
+	com_attach_subr(sc);
+
+	msc->sc_ih = evbmips_intr_establish(ma->ma_irq, comintr, sc);
+	if (msc->sc_ih == NULL) {
+		aprint_error_dev(self, "unable to establish interrupt\n");
+		return;
+	}
+}
diff --git a/sys/arch/evbmips/rtl8672/machdep.c b/sys/arch/evbmips/rtl8672/machdep.c
new file mode 100644
index 000000000..78129b57e
--- /dev/null
+++ b/sys/arch/evbmips/rtl8672/machdep.c
@@ -0,0 +1,272 @@
+/*	$NetBSD$	*/
+
+/*
+ * Machine-dependent startup for Realtek RTL8672 boards (ZTE ZXHN H108N).
+ *
+ * The kernel is entered from the vendor Linux through a small loader
+ * module: it is copied to its link address and started with interrupts
+ * off.  Nothing is passed in registers.
+ */
+
+#include <sys/cdefs.h>
+__KERNEL_RCSID(0, "$NetBSD$");
+
+#include "opt_ddb.h"
+
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/boot_flag.h>
+#include <sys/bus.h>
+#include <sys/cpu.h>
+#include <sys/device.h>
+#include <sys/kcore.h>
+#include <sys/kernel.h>
+#include <sys/ksyms.h>
+#include <sys/mount.h>
+#include <sys/mutex.h>
+#include <sys/reboot.h>
+#include <sys/termios.h>
+
+#include <uvm/uvm_extern.h>
+
+#include <dev/cons.h>
+
+#include <dev/ic/comreg.h>
+#include <dev/ic/comvar.h>
+
+#if defined(DDB)
+#include <mips/db_machdep.h>
+#include <ddb/db_extern.h>
+#endif
+
+#include <mips/cache.h>
+#include <mips/locore.h>
+#include <mips/cpuregs.h>
+
+#include <evbmips/rtl8672/rtl8672reg.h>
+#include <evbmips/rtl8672/rtl8672var.h>
+
+/* Maps for VM objects. */
+struct vm_map *phys_map = NULL;
+
+struct rtl8672_config rtl8672_configuration;
+
+int mem_cluster_cnt;
+phys_ram_seg_t mem_clusters[VM_PHYSSEG_MAX];
+
+void	mach_init(u_long, u_long, u_long, u_long);
+
+#define	UART_REG(n)							\
+	(*(volatile uint8_t *)MIPS_PHYS_TO_KSEG1(RTL8672_UART0_BASE +	\
+	    ((n) << RTL8672_UART_REGSHIFT)))
+
+/*
+ * A very simple output-only console so that printf() works before the
+ * real console is initialised.
+ */
+static void
+early_putc(dev_t dev, int c)
+{
+	int timo = 1000000;
+
+	while ((UART_REG(com_lsr) & LSR_TXRDY) == 0 && --timo > 0)
+		continue;
+	UART_REG(com_data) = (uint8_t)c;
+}
+
+static void
+rtl8672_wbflush(void)
+{
+
+	/* nothing to drain */
+}
+
+static struct consdev early_console = {
+	.cn_putc = early_putc,
+	.cn_dev = makedev(0, 0),
+	.cn_pri = CN_DEAD
+};
+
+/*
+ * The UART reference clock is not documented.  Whoever started us left
+ * the port running at 115200 baud, so derive the clock from the divisor
+ * that is currently programmed.
+ */
+static u_int
+uart_probe_freq(void)
+{
+	uint8_t lcr;
+	u_int divisor;
+
+	lcr = UART_REG(com_lctl);
+	UART_REG(com_lctl) = lcr | LCR_DLAB;
+	divisor = UART_REG(com_dlbl) | (UART_REG(com_dlbh) << 8);
+	UART_REG(com_lctl) = lcr;
+
+	if (divisor == 0 || divisor == 0xffff)
+		return RTL8672_BUS_FREQ;
+	return divisor * 16 * RTL8672_UART_BAUD;
+}
+
+void
+mach_init(u_long arg0, u_long arg1, u_long arg2, u_long arg3)
+{
+	struct rtl8672_config *rcp = &rtl8672_configuration;
+	struct com_regs regs;
+	void *kernend;
+	extern char edata[], end[];	/* XXX */
+
+	/* The vendor system leaves the watchdog running. */
+	RTL8672_REG(RTL8672_WDTCNR) = RTL8672_WDT_STOP;
+
+	/* No device may interrupt until a handler is established. */
+	RTL8672_REG(RTL8672_GIMR) = 0;
+
+	kernend = (void *)mips_round_page(end);
+	memset(edata, 0, end - edata);
+
+	/* enough of a console for printf() to work */
+	cn_tab = &early_console;
+
+	cpu_setmodel("ZTE ZXHN H108N (Realtek RTL8672)");
+
+	mips_vector_init(NULL, false);
+
+	/*
+	 * The generic MIPS-I wbflush() spins on "bc0f", waiting for the
+	 * external write buffer of a real R3000.  This SoC has none, and
+	 * the Lexra core does not provide that condition.
+	 */
+	mips_set_wbflush(rtl8672_wbflush);
+
+	/* No CP0 counter on this core; these are nominal values. */
+	curcpu()->ci_cpu_freq = RTL8672_CPU_FREQ;
+	curcpu()->ci_cctr_freq = RTL8672_CPU_FREQ;
+	curcpu()->ci_cycles_per_hz = (RTL8672_CPU_FREQ + hz / 2) / hz;
+	curcpu()->ci_divisor_delay = (RTL8672_CPU_FREQ + 500000) / 1000000;
+
+	uvm_md_init();
+
+	/*
+	 * Initialize bus space tags and bring up the main console.
+	 */
+	rtl8672_bus_mem_init(&rcp->rc_memt, rcp);
+	rtl8672_dma_init(rcp);
+
+	rcp->rc_uart_freq = uart_probe_freq();
+	com_init_regs_stride(&regs, &rcp->rc_memt, 0, RTL8672_UART0_BASE,
+	    RTL8672_UART_REGSHIFT);
+	if (comcnattach1(&regs, RTL8672_UART_BAUD, rcp->rc_uart_freq,
+	    COM_TYPE_NORMAL,
+	    (TTYDEF_CFLAG & ~(CSIZE | PARENB)) | CS8) != 0)
+		panic("unable to initialize serial console");
+
+	printf("RTL8672: UART clock %u Hz\n", rcp->rc_uart_freq);
+
+	/* There is no way of passing arguments yet. */
+	boothowto = RB_AUTOBOOT;
+
+	physmem = btoc(RTL8672_RAM_SIZE);
+	mem_clusters[0].start = PAGE_SIZE;
+	mem_clusters[0].size = RTL8672_RAM_SIZE - PAGE_SIZE;
+	mem_cluster_cnt = 1;
+
+	/*
+	 * Load the available pages into the VM system.
+	 */
+	mips_page_physload(MIPS_KSEG0_START, (vaddr_t)kernend,
+	    mem_clusters, mem_cluster_cnt, NULL, 0);
+
+	/*
+	 * Initialize message buffer (at end of core).
+	 */
+	mips_init_msgbuf();
+
+	/*
+	 * Initialize the virtual memory system.
+	 */
+	pmap_bootstrap();
+
+	/*
+	 * Allocate uarea page for lwp0 and set it.
+	 */
+	mips_init_lwp0_uarea();
+
+#ifdef DDB
+	if (boothowto & RB_KDB)
+		Debugger();
+#endif
+}
+
+void
+consinit(void)
+{
+
+	/*
+	 * Everything related to console initialization is done
+	 * in mach_init().
+	 */
+}
+
+void
+cpu_startup(void)
+{
+
+	cpu_startup_common();
+	rtl8672_configuration.rc_mallocsafe = 1;
+}
+
+void
+cpu_reboot(int howto, char *bootstr)
+{
+	static int waittime = -1;
+
+	/* Take a snapshot before clobbering any registers. */
+	savectx(curpcb);
+
+	/* If "always halt" was specified as a boot flag, obey. */
+	if (boothowto & RB_HALT)
+		howto |= RB_HALT;
+
+	boothowto = howto;
+
+	/* If system is cold, just halt. */
+	if (cold) {
+		boothowto |= RB_HALT;
+		goto haltsys;
+	}
+
+	if ((boothowto & RB_NOSYNC) == 0 && waittime < 0) {
+		waittime = 0;
+		vfs_shutdown();
+	}
+
+	/* Disable interrupts. */
+	splhigh();
+
+	if (boothowto & RB_DUMP)
+		dumpsys();
+
+haltsys:
+	/* Run any shutdown hooks. */
+	doshutdownhooks();
+
+	if (boothowto & RB_HALT) {
+		printf("\n");
+		printf("The operating system has halted.\n");
+		printf("Please press any key to reboot.\n\n");
+		cnpollc(1);	/* For proper keyboard command handling */
+		cngetc();
+		cnpollc(0);
+	}
+
+	printf("resetting...\n\n");
+	delay(100000);
+
+	/* An immediately expiring watchdog resets the whole board. */
+	RTL8672_REG(RTL8672_WDTCNR) = RTL8672_WDT_RESET;
+
+	for (;;)
+		continue;
+	/*NOTREACHED*/
+}
