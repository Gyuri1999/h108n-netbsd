diff --git a/distrib/evbmips/rtl8672ramdisk/Makefile b/distrib/evbmips/rtl8672ramdisk/Makefile
new file mode 100644
index 000000000..b26bd000d
--- /dev/null
+++ b/distrib/evbmips/rtl8672ramdisk/Makefile
@@ -0,0 +1,38 @@
+#	$NetBSD$
+#
+# Small root file system for RTL8672 boards (ZTE ZXHN H108N): init, a
+# shell and a handful of tools in one crunched binary, meant to be put
+# into the kernel's memory disk with mdsetimage.
+
+.include <bsd.own.mk>
+.include "${NETBSDSRCDIR}/distrib/common/Makefile.distrib"
+
+IMAGE=		ramdisk.fs
+IMAGESIZE=	3072k
+MAKEFS_FLAGS+=	-f 15
+IMAGEENDIAN=	be
+
+WARNS=		1
+DBG=		-Os
+
+CRUNCHBIN=	ramdiskbin
+LISTS=		${.CURDIR}/list
+MTREECONF=	${DISTRIBDIR}/common/mtree.common
+IMAGEDEPENDS=	${CRUNCHBIN} \
+		dot.profile \
+		${NETBSDSRCDIR}/etc/group ${NETBSDSRCDIR}/etc/master.passwd
+
+MAKEDEVTARGETS=	std md0 ipty
+
+HACKSRC=	${DISTRIBDIR}/utils/libhack
+
+.include	"${HACKSRC}/Makefile.inc"
+${CRUNCHBIN}:	libhack.o
+
+.include "${DISTRIBDIR}/common/Makefile.crunch"
+.include "${DISTRIBDIR}/common/Makefile.makedev"
+.include "${DISTRIBDIR}/common/Makefile.image"
+
+release:
+
+.include <bsd.prog.mk>
diff --git a/distrib/evbmips/rtl8672ramdisk/dot.profile b/distrib/evbmips/rtl8672ramdisk/dot.profile
new file mode 100644
index 000000000..8c712ff5d
--- /dev/null
+++ b/distrib/evbmips/rtl8672ramdisk/dot.profile
@@ -0,0 +1,27 @@
+# $NetBSD$
+#
+# Shell startup for the RTL8672 memory disk root.
+
+PATH=/sbin:/bin:/usr/bin:/usr/sbin:/
+export PATH
+TERM=vt100
+export TERM
+HOME=/
+export HOME
+
+umask 022
+
+if [ "X${DONEPROFILE}" = "X" ]; then
+	DONEPROFILE=YES
+	export DONEPROFILE
+
+	stty newcrt werase ^W intr ^C kill ^U erase ^?
+
+	# make the memory disk writable and show kernel state under /kern
+	mount -u /dev/md0a /
+	mount -t kernfs /kern /kern
+
+	echo ''
+	echo 'NetBSD on the ZTE ZXHN H108N (Realtek RTL8672, Lexra RLX5281)'
+	echo ''
+fi
