--- /dev/null
+++ b/sys/arch/mips/include/cache_lexra.h
@@ -0,0 +1,27 @@
+/*	$NetBSD$	*/
+
+/*
+ * Cache operations for Lexra/Realtek RLX cores (e.g. RLX5281).
+ *
+ * These cores are MIPS-I compatible but do not implement the R3000
+ * "isolate cache" mechanism.  Caches are controlled through the CCTL
+ * register, coprocessor 0 register 20: an operation is started by a
+ * 0 -> 1 transition of its control bit.
+ */
+
+#ifndef _MIPS_CACHE_LEXRA_H_
+#define _MIPS_CACHE_LEXRA_H_
+
+#define	LEXRA_CCTL_DINVAL	0x00000001	/* invalidate D-cache */
+#define	LEXRA_CCTL_IINVAL	0x00000002	/* invalidate I-cache */
+#define	LEXRA_CCTL_DWB		0x00000100	/* write back D-cache */
+#define	LEXRA_CCTL_DWBINVAL	0x00000200	/* write back + invalidate D */
+
+#ifdef _KERNEL
+void	lexra_icache_sync_all(void);
+void	lexra_icache_sync_range(register_t, vsize_t);
+void	lexra_pdcache_wbinv_all(void);
+void	lexra_pdcache_wbinv_range(register_t, vsize_t);
+#endif
+
+#endif /* _MIPS_CACHE_LEXRA_H_ */
