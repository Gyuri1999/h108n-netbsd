diff --git a/sys/arch/mips/mips/cache_lexra.c b/sys/arch/mips/mips/cache_lexra.c
new file mode 100644
index 000000000..a531ddc4b
--- /dev/null
+++ b/sys/arch/mips/mips/cache_lexra.c
@@ -0,0 +1,82 @@
+/*	$NetBSD$	*/
+
+/*
+ * Cache operations for Lexra/Realtek RLX cores (e.g. RLX5281).
+ *
+ * The control bits and the "clear then set" sequence were taken from the
+ * behaviour of the vendor kernel: bit 1 of CCTL invalidates the I-cache,
+ * bit 9 writes back and invalidates the D-cache.  There are no per-line
+ * operations here; every request flushes the whole cache, which is slow
+ * but always correct.
+ */
+
+#include <sys/cdefs.h>
+__KERNEL_RCSID(0, "$NetBSD$");
+
+#include <sys/param.h>
+#include <sys/types.h>
+
+#include <mips/cpuregs.h>
+#include <mips/locore.h>
+#include <mips/cache.h>
+#include <mips/cache_lexra.h>
+
+static inline uint32_t
+lexra_cctl_read(void)
+{
+	uint32_t v;
+
+	__asm volatile("mfc0 %0, $20; nop" : "=r"(v));
+	return v;
+}
+
+static inline void
+lexra_cctl_write(uint32_t v)
+{
+
+	__asm volatile("mtc0 %0, $20; nop; nop" : : "r"(v));
+}
+
+/* Start a cache operation: its bit has to go from 0 to 1. */
+static void
+lexra_cctl_pulse(uint32_t bit)
+{
+	const uint32_t sr = mips_cp0_status_read();
+	uint32_t cctl;
+
+	mips_cp0_status_write(sr & ~MIPS_SR_INT_IE);
+	cctl = lexra_cctl_read() | bit;
+	lexra_cctl_write(cctl ^ bit);
+	lexra_cctl_write(cctl);
+	mips_cp0_status_write(sr);
+}
+
+void
+lexra_pdcache_wbinv_all(void)
+{
+
+	lexra_cctl_pulse(LEXRA_CCTL_DWBINVAL);
+}
+
+void
+lexra_pdcache_wbinv_range(register_t va, vsize_t size)
+{
+
+	lexra_cctl_pulse(LEXRA_CCTL_DWBINVAL);
+}
+
+void
+lexra_icache_sync_all(void)
+{
+
+	/* New instructions may still be sitting in the D-cache. */
+	lexra_cctl_pulse(LEXRA_CCTL_DWBINVAL);
+	lexra_cctl_pulse(LEXRA_CCTL_IINVAL);
+}
+
+void
+lexra_icache_sync_range(register_t va, vsize_t size)
+{
+
+	lexra_icache_sync_all();
+}
