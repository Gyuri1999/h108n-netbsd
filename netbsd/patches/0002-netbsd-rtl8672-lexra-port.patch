diff --git a/sys/arch/evbmips/rtl8672/rtl8672_intr.c b/sys/arch/evbmips/rtl8672/rtl8672_intr.c
new file mode 100644
index 000000000..6c901675d
--- /dev/null
+++ b/sys/arch/evbmips/rtl8672/rtl8672_intr.c
@@ -0,0 +1,215 @@
+/*	$NetBSD$	*/
+
+/*
+ * Interrupt handling for the RTL8672.
+ *
+ * All on-chip sources go through one controller: GIMR masks them, GISR
+ * shows what is pending, and four routing registers steer each source to
+ * one of the CPU interrupt lines.  The layout of the routing registers is
+ * not documented, so the values of the vendor kernel are used as they are
+ * and the CPU line that the timer ends up on is found by experiment.  That
+ * line alone is left open at IPL_VM, which gives the clock its own level.
+ */
+
+#include <sys/cdefs.h>
+__KERNEL_RCSID(0, "$NetBSD$");
+
+#define __INTR_PRIVATE
+
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/bitops.h>
+#include <sys/cpu.h>
+#include <sys/device.h>
+#include <sys/intr.h>
+#include <sys/kernel.h>
+#include <sys/kmem.h>
+#include <sys/queue.h>
+
+#include <mips/locore.h>
+#include <mips/cpuregs.h>
+
+#include <evbmips/rtl8672/rtl8672reg.h>
+#include <evbmips/rtl8672/rtl8672var.h>
+
+struct intrhand {
+	LIST_ENTRY(intrhand) ih_q;
+	int (*ih_func)(void *);
+	void *ih_arg;
+	int ih_irq;
+};
+
+static LIST_HEAD(intrlist, intrhand) intrs[RTL8672_NIRQ];
+static struct evcnt rtl8672_clock_ev;
+static struct evcnt rtl8672_dev_ev;
+static struct evcnt rtl8672_stray_ev;
+
+/* CPU interrupt line(s) the timer is routed to (Cause/Status bits). */
+static uint32_t rtl8672_timer_line;
+
+static uint32_t
+rtl8672_probe_timer_line(void)
+{
+	uint32_t lines = 0;
+	int i;
+
+	/* Run the timer at hz with its interrupt enabled... */
+	RTL8672_REG(RTL8672_TCCNR) = 0;
+	RTL8672_REG(RTL8672_CDBR) = RTL8672_TIMER_DIV << 16;
+	RTL8672_REG(RTL8672_TC0DATA) =
+	    ((RTL8672_BUS_FREQ / RTL8672_TIMER_DIV) / hz) << 8;
+	RTL8672_REG(RTL8672_TCIR) = RTL8672_TCIR_TC0IE | RTL8672_TCIR_TC0IP;
+	RTL8672_REG(RTL8672_TCCNR) =
+	    RTL8672_TCCNR_TC0EN | RTL8672_TCCNR_TC0MODE;
+
+	/* ...let only the timer through the controller... */
+	RTL8672_REG(RTL8672_GIMR) = 1U << RTL8672_IRQ_TIMER;
+
+	/* ...and see which CPU line goes up when it fires. */
+	for (i = 0; i < 20000000; i++) {
+		if (RTL8672_REG(RTL8672_TCIR) & RTL8672_TCIR_TC0IP) {
+			lines = mips_cp0_cause_read() & MIPS_HARD_INT_MASK;
+			break;
+		}
+	}
+
+	RTL8672_REG(RTL8672_GIMR) = 0;
+	RTL8672_REG(RTL8672_TCIR) = RTL8672_TCIR_TC0IE | RTL8672_TCIR_TC0IP;
+
+	return lines;
+}
+
+void
+evbmips_intr_init(void)
+{
+	struct ipl_sr_map map;
+	int i;
+
+	for (i = 0; i < RTL8672_NIRQ; i++)
+		LIST_INIT(&intrs[i]);
+
+	RTL8672_REG(RTL8672_GIMR) = 0;
+	RTL8672_REG(RTL8672_IRR0) = RTL8672_IRR0_DEFAULT;
+	RTL8672_REG(RTL8672_IRR1) = RTL8672_IRR1_DEFAULT;
+	RTL8672_REG(RTL8672_IRR2) = RTL8672_IRR2_DEFAULT;
+	RTL8672_REG(RTL8672_IRR3) = RTL8672_IRR3_DEFAULT;
+
+	rtl8672_timer_line = rtl8672_probe_timer_line();
+	if (rtl8672_timer_line == 0) {
+		printf("rtl8672: timer interrupt line not found, "
+		    "assuming INT5\n");
+		rtl8672_timer_line = MIPS_INT_MASK_5;
+	} else {
+		printf("rtl8672: timer on CPU interrupt mask 0x%04x\n",
+		    rtl8672_timer_line);
+	}
+
+	memset(&map, 0, sizeof(map));
+	map.sr_bits[IPL_NONE] = 0;
+	map.sr_bits[IPL_SOFTCLOCK] = MIPS_SOFT_INT_MASK_0;
+	map.sr_bits[IPL_SOFTNET] = MIPS_SOFT_INT_MASK;
+	map.sr_bits[IPL_VM] = MIPS_SOFT_INT_MASK |
+	    (MIPS_HARD_INT_MASK & ~rtl8672_timer_line);
+	map.sr_bits[IPL_SCHED] = MIPS_INT_MASK;
+	map.sr_bits[IPL_DDB] = MIPS_INT_MASK;
+	map.sr_bits[IPL_HIGH] = MIPS_INT_MASK;
+	ipl_sr_map = map;
+
+	evcnt_attach_dynamic(&rtl8672_clock_ev, EVCNT_TYPE_INTR, NULL,
+	    "rtl8672", "clock");
+	evcnt_attach_dynamic(&rtl8672_dev_ev, EVCNT_TYPE_INTR, NULL,
+	    "rtl8672", "device");
+	evcnt_attach_dynamic(&rtl8672_stray_ev, EVCNT_TYPE_INTR, NULL,
+	    "rtl8672", "stray");
+
+	rtl8672_delay_calibrate();
+}
+
+void
+evbmips_iointr(int ipl, uint32_t ipending, struct clockframe *cf)
+{
+	uint32_t pending;
+
+	if (ipending & rtl8672_timer_line) {
+		/* Acknowledge, keeping the enable bit. */
+		RTL8672_REG(RTL8672_TCIR) =
+		    RTL8672_TCIR_TC0IE | RTL8672_TCIR_TC0IP;
+		rtl8672_clock_ev.ev_count++;
+		hardclock(cf);
+	}
+
+	if ((ipending & MIPS_HARD_INT_MASK & ~rtl8672_timer_line) == 0)
+		return;
+
+	pending = RTL8672_REG(RTL8672_GISR) & RTL8672_REG(RTL8672_GIMR) &
+	    ~(1U << RTL8672_IRQ_TIMER);
+	if (pending == 0) {
+		rtl8672_stray_ev.ev_count++;
+		return;
+	}
+
+	while (pending != 0) {
+		const int irq = ffs32(pending) - 1;
+		struct intrhand *ih;
+
+		pending &= ~(1U << irq);
+		rtl8672_dev_ev.ev_count++;
+		LIST_FOREACH(ih, &intrs[irq], ih_q) {
+			if (ih->ih_func != NULL)
+				(*ih->ih_func)(ih->ih_arg);
+		}
+	}
+}
+
+void *
+evbmips_intr_establish(int irq, int (*func)(void *), void *arg)
+{
+	struct intrhand *ih;
+	int s;
+
+	if (irq < 0 || irq >= RTL8672_NIRQ || irq == RTL8672_IRQ_TIMER) {
+		aprint_error("%s: invalid irq %d\n", __func__, irq);
+		return NULL;
+	}
+
+	ih = kmem_alloc(sizeof(*ih), KM_SLEEP);
+	ih->ih_func = func;
+	ih->ih_arg = arg;
+	ih->ih_irq = irq;
+
+	s = splhigh();
+	LIST_INSERT_HEAD(&intrs[irq], ih, ih_q);
+	RTL8672_REG(RTL8672_GIMR) |= 1U << irq;
+	splx(s);
+
+	return ih;
+}
+
+void
+evbmips_intr_disestablish(void *cookie)
+{
+	struct intrhand *ih = cookie;
+	int s;
+
+	s = splhigh();
+	LIST_REMOVE(ih, ih_q);
+	if (LIST_EMPTY(&intrs[ih->ih_irq]))
+		RTL8672_REG(RTL8672_GIMR) &= ~(1U << ih->ih_irq);
+	splx(s);
+
+	kmem_free(ih, sizeof(*ih));
+}
+
+/* Called from cpu_initclocks(): let the timer through. */
+void	rtl8672_clock_enable(void);
+
+void
+rtl8672_clock_enable(void)
+{
+	int s;
+
+	s = splhigh();
+	RTL8672_REG(RTL8672_TCIR) = RTL8672_TCIR_TC0IE | RTL8672_TCIR_TC0IP;
+	RTL8672_REG(RTL8672_GIMR) |= 1U << RTL8672_IRQ_TIMER;
+	splx(s);
+}
diff --git a/sys/arch/evbmips/rtl8672/rtl8672reg.h b/sys/arch/evbmips/rtl8672/rtl8672reg.h
new file mode 100644
index 000000000..7e13f678e
--- /dev/null
+++ b/sys/arch/evbmips/rtl8672/rtl8672reg.h
@@ -0,0 +1,74 @@
+/*	$NetBSD$	*/
+
+/*
+ * Realtek RTL8672 on-chip peripherals.
+ *
+ * No documentation was available; every address and value here was read
+ * out of the vendor boot loader and Linux kernel of a ZTE ZXHN H108N and
+ * the ones marked (verified) were confirmed on the hardware.
+ */
+
+#ifndef _EVBMIPS_RTL8672_RTL8672REG_H_
+#define _EVBMIPS_RTL8672_RTL8672REG_H_
+
+#define	RTL8672_RAM_SIZE	(32 * 1024 * 1024)
+
+/* Peripheral window (physical addresses) */
+#define	RTL8672_IO_BASE		0x18000000
+#define	RTL8672_IO_SIZE		0x08000000
+
+/* 16550 UART, registers 4 bytes apart (verified) */
+#define	RTL8672_UART0_BASE	0x18002100
+#define	RTL8672_UART_REGSHIFT	2
+#define	RTL8672_UART_BAUD	115200
+
+/* Interrupt controller */
+#define	RTL8672_GIMR		0x18003000	/* global interrupt mask */
+#define	RTL8672_GISR		0x18003004	/* global interrupt status */
